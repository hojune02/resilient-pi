
{
  "uid": "resilient-pi-day08",
  "title": "Resilient Pi — Observability",
  "tags": ["resilient-pi", "day08", "systems"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "HTTP Throughput (requests/sec)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "ag125lqzwh88wb"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(resilient_http_requests_total[1m])",
          "legendFormat": "Requests/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"}
      }
    },
    {
      "id": 2,
      "title": "HTTP Error Rate (errors/sec)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "ag125lqzwh88wb"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(resilient_http_errors_total[1m])",
          "legendFormat": "Errors/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps", "min": 0}
      }
    },
    {
      "id": 3,
      "title": "HTTP p95 Latency",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "ag125lqzwh88wb"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(resilient_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95 latency"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0}
      }
    },
    {
      "id": 4,
      "title": "Database Availability",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "ag125lqzwh88wb"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "resilient_db_connection_up",
          "legendFormat": "Last known DB state"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "decimals": 0
        }
      }
    },
    {
      "id": 5,
      "title": "Database Operation p95 Latency",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "ag125lqzwh88wb"},
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(resilient_db_operation_duration_seconds_bucket[1m])))",
          "legendFormat": "DB p95"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0}
      }
    },
    {
      "id": 6,
      "title": "Active HTTP Connections",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "ag125lqzwh88wb"},
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "resilient_http_active_connections",
          "legendFormat": "Accepted connections"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "none", "min": 0}
      }
    },
    {
      "id": 7,
      "title": "Host CPU Utilization",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "ag125lqzwh88wb"},
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "legendFormat": "CPU utilization"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100}
      }
    },
    {
      "id": 8,
      "title": "Host Available Memory",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "ag125lqzwh88wb"},
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Available memory"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "bytes", "min": 0}
      }
    }
  ]
}
